#!/bin/bash
# 프로젝트 루트 디렉토리로 이동
cd "$(dirname "$0")/.."

echo "=================================================="
echo "    🏦 재무 데이터베이스 구축 스크립트 실행 🏦"
echo "=================================================="

# 가상환경 파이썬으로 스크립트 실행
./venv/bin/python ./scripts/build_financial_db.py

echo ""
echo "재무 데이터베이스 구축이 완료되었습니다."
echo "아무 키나 눌러 창을 닫으세요."
read -n 1 -s -r
