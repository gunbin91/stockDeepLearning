#!/bin/bash
# 프로젝트 루트 디렉토리로 이동
cd "$(dirname "$0")/.."

echo "=================================================="
echo "      📈 백테스팅 스크립트 실행 📈"
echo "=================================================="

# 초기 자본금 입력받기
echo "초기 자본금을 입력하세요 (기본값 10억, Enter로 스킵):"
read -p "입력: " CAPITAL
if [ -z "$CAPITAL" ]; then
    CAPITAL=1000000000
fi

echo "--------------------------------------------------"
echo "초기 자본금 $CAPITAL 원으로 백테스팅을 시작합니다..."
echo "--------------------------------------------------"

# 가상환경 파이썬으로 백테스트 스크립트 실행
./venv/bin/python ./scripts/backtest.py --capital $CAPITAL

echo ""
echo "백테스팅이 완료되었습니다. backtest_report.html 파일을 확인하세요."
echo "아무 키나 눌러 창을 닫으세요."
read -n 1 -s -r