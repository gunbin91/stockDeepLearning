#!/bin/bash
# 현재 스크립트 파일이 있는 디렉토리로 이동
cd "$(dirname "$0")"

echo "=================================================="
echo "      📈 백테스팅 스크립트 실행 📈"
echo "=================================================="
echo "저장된 모델과 최적 가중치를 사용하여 백테스팅을 시작합니다."
echo "완료되면 backtest_report.html 파일이 생성됩니다."
echo "--------------------------------------------------"

# 가상환경 파이썬으로 백테스트 스크립트 실행
./venv/bin/python backtest.py

echo "
백테스팅이 완료되었습니다. backtest_report.html 파일을 확인하세요."
echo "아무 키나 눌러 창을 닫으세요."
read -n 1 -s -r
